{
  "info": {
    "_postman_id": "7128e22e-64ad-4be9-aeec-8a992ba63df7",
    "name": "FinCheck Financial Fraud Detection API",
    "description": "Runnable API checks. Run in order with the local Flask server; variable test_id is created by Create legitimate transaction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"base_url","value":"http://127.0.0.1:5000"},
    {"key":"test_id","value":"POSTMAN-DEMO-001"}
  ],
  "item": [
    {"name":"Health", "request":{"method":"GET","url":"{{base_url}}/api/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('health returns 200', () => pm.response.to.have.status(200));","pm.test('service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok')); "]}}]},
    {"name":"Create legitimate transaction", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"transaction_id\": \"{{test_id}}\",\n  \"amount\": 2500,\n  \"location\": \"India\",\n  \"transaction_type\": \"PURCHASE\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('created with 201', () => pm.response.to.have.status(201));","const body = pm.response.json();","pm.test('has transaction result', () => { pm.expect(body.transaction_id).to.eql(pm.collectionVariables.get('test_id')); pm.expect(body.risk_score).to.eql(0); pm.expect(body.status).to.eql('LEGITIMATE'); });"]}}]},
    {"name":"Create suspicious transaction", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"transaction_id\":\"POSTMAN-SUSPICIOUS-001\",\"amount\":150000,\"location\":\"Atlantis\",\"transaction_type\":\"TRANSFER\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('created as suspicious', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().risk_score).to.eql(75); pm.expect(pm.response.json().status).to.eql('SUSPICIOUS'); });"]}}]},
    {"name":"Reject missing transaction ID", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"amount\":2500,\"location\":\"India\",\"transaction_type\":\"PURCHASE\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('missing ID is 400 JSON error', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.include('transaction_id'); });"]}}]},
    {"name":"Reject invalid amount", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"transaction_id\":\"POSTMAN-BAD-AMOUNT\",\"amount\":-5,\"location\":\"India\",\"transaction_type\":\"PURCHASE\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('invalid amount is 400', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.include('amount'); });"]}}]},
    {"name":"Reject invalid transaction type", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"transaction_id\":\"POSTMAN-BAD-TYPE\",\"amount\":20,\"location\":\"India\",\"transaction_type\":\"GAMBLE\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('invalid type is 400', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.include('transaction_type'); });"]}}]},
    {"name":"Reject duplicate transaction ID", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"transaction_id\":\"{{test_id}}\",\"amount\":2500,\"location\":\"India\",\"transaction_type\":\"PURCHASE\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('duplicate is 409', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().error).to.include('already exists'); });"]}}]},
    {"name":"List transactions", "request":{"method":"GET","url":"{{base_url}}/api/transactions"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('list contains test record', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().transactions.some(t => t.transaction_id === pm.collectionVariables.get('test_id'))).to.be.true; });"]}}]},
    {"name":"Get transaction", "request":{"method":"GET","url":"{{base_url}}/api/transactions/{{test_id}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('get existing record', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().transaction_id).to.eql(pm.collectionVariables.get('test_id')); });"]}}]},
    {"name":"Get nonexistent transaction", "request":{"method":"GET","url":"{{base_url}}/api/transactions/POSTMAN-NOT-FOUND"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('missing is 404 JSON error', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.include('not found'); });"]}}]},
    {"name":"Malformed JSON", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{broken json","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/analyze"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('malformed JSON is 400', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.be.a('string'); });"]}}]},
    {"name":"Delete transaction", "request":{"method":"DELETE","url":"{{base_url}}/api/transactions/{{test_id}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('delete existing record', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().transaction_id).to.eql(pm.collectionVariables.get('test_id')); });"]}}]},
    {"name":"Delete nonexistent transaction", "request":{"method":"DELETE","url":"{{base_url}}/api/transactions/POSTMAN-NOT-FOUND"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('delete missing is 404', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error).to.include('not found'); });"]}}]}
  ]
}
